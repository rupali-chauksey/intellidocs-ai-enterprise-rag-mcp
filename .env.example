


# 🔑 GROQ API Key - Get from https://console.groq.com/keys
# IMPORTANT: Make sure to set your actual key in .env (this file is just a template)
GROQ_API_KEY=

# LLM Model to use (see https://console.groq.com/docs/models for available models)
LLM_MODEL=openai/gpt-oss-120b
# Vector store and data directories
CHROMA_DIR=./chroma_db
DATA_DIR=./data

# Optional embedding model (used for semantic search)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking parameters for document ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval parameters
TOP_K=4
GROUNDEDNESS_THRESHOLD=0.35